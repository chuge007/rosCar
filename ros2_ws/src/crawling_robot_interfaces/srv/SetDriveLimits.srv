float64 max_linear_speed_m_s
float64 max_angular_speed_rad_s
float64 max_linear_accel_m_s2
float64 max_angular_accel_rad_s2
# Safety cap applied uniformly to the two physical wheel speeds.
float64 max_wheel_speed_m_s
# Minimum inner/outer wheel speed ratio during a translating turn.
float64 minimum_inner_wheel_ratio
