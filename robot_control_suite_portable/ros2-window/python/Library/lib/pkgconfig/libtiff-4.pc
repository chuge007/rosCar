prefix=D:/ros2/pixi_ws/ros2-window/.pixi/envs/default/Library
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libtiff
Description:  Tag Image File Format (TIFF) library.
Version: 4.6.0
Libs: -L${libdir} -ltiff
Libs.private:  -ldeflate -lLerc
Cflags: -I${includedir}
Requires.private:  zlib libjpeg liblzma libzstd
