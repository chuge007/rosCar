{
    "device": {
        "type": "USB"
    },
    "frame": {
        "capacity": 64,
        "sampling_enable": false,
        "sampling_rate": 20
    },
    "log": {
        "file_enable": true,
        "level": "info",
        "path": "logs/",
        "prefix": "log"
    },
    "network": {
        "command_port": 8080,
        "listen_host": "127.0.0.1",
        "ultrasonic_port": 8081
    },
    "start": {
        "auto": false,
        "delay": 3000,
        "mode": "combo"
    },
    "thread": {
        "capacity": 10
    }
}